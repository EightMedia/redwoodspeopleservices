# Mail via Resend (https://resend.com) – nodig voor het contactformulier
RESEND_API_KEY=re_xxxxxxxxx
# Afzender: moet een geverifieerd domein zijn in Resend, bijv. noreply@redwoodspeopleservices.nl
MAIL_FROM="Redwoods website <noreply@redwoodspeopleservices.nl>"
# Ontvanger van contactformulier-berichten
MAIL_TO=secretariaat@redwoodspeopleservices.nl

# Optioneel: Cloudflare Turnstile (spamcheck). Laat leeg om zonder te werken.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optioneel: Keystatic in productie. Cloud: PUBLIC_KEYSTATIC_CLOUD_PROJECT=team/project.
# GitHub-modus: de vier variabelen die de setup op /keystatic oplevert.
PUBLIC_KEYSTATIC_CLOUD_PROJECT=
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Mollie (aanbetaling Houd me Vast). test_… om te testen, live_… in productie. Leeg = aanmelding per mail zonder betaling.
MOLLIE_API_KEY=
# Zet op "true" zodat het formulier de betaalstap aankondigt (hoort samen met MOLLIE_API_KEY)
PUBLIC_MOLLIE_ENABLED=

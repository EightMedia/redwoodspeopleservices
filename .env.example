# Mail via Resend (https://resend.com) – nodig voor het contactformulier
RESEND_API_KEY=re_xxxxxxxxx
# Afzender: moet een geverifieerd domein zijn in Resend, bijv. noreply@redwoodspeopleservices.nl
MAIL_FROM="Redwoods website <noreply@redwoodspeopleservices.nl>"
# Ontvanger van contactformulier-berichten
MAIL_TO=secretariaat@redwoodspeopleservices.nl

# Optioneel: Cloudflare Turnstile (spamcheck). Laat leeg om zonder te werken.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Sanity project (organisation Eight Media BV). Dataset is normally `production`.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Public site origin for canonical URLs, Open Graph, sitemap and robots. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.redwoodspeopleservices.nl

# Studio URL for click-to-edit (Presentation tool). Local Studio runs on :3333.
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Server-only read token for drafts / preview. Never use a NEXT_PUBLIC_ prefix.
SANITY_API_READ_TOKEN=

# Sanity webhook secret for /api/revalidate. Required in production.
SANITY_REVALIDATE_SECRET=

# Mollie (deposit for Houd me Vast). test_… to test, live_… in production.
# Empty = registration by mail only, without payment.
MOLLIE_API_KEY=
# Set to "true" so the registration form announces the payment step (goes with MOLLIE_API_KEY).
NEXT_PUBLIC_MOLLIE_ENABLED=

# Mail via Resend (https://resend.com) for the contact and registration forms.
RESEND_API_KEY=
# Sender: must be a verified domain in Resend.
MAIL_FROM="Redwoods website <noreply@redwoodspeopleservices.nl>"
# Recipient of form messages.
MAIL_TO=secretariaat@redwoodspeopleservices.nl

# Cloudflare Turnstile (spam check on the contact and registration forms). Always set both:
# with only the secret key the server rejects every submission. Empty = honeypot, fill-in
# time and content filter only, and no confirmation mail from the contact form.
# The site key is inlined at build time, so redeploy after changing it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Local development only: folder that holds both this repo and kikker-core, so Turbopack
# may read the linked Kikker packages (see README). Leave unset on Vercel.
KIKKER_LINK_ROOT=

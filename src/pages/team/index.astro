---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHeader from "../../components/PageHeader.astro";
import Section from "../../components/Section.astro";
import TeamCard from "../../components/TeamCard.astro";
import Cta from "../../components/Cta.astro";
const team = (await getCollection("team")).sort((a, b) => a.data.order - b.data.order);
---

<Base title="Ons team" description="Maak kennis met de therapeuten, relatietherapeuten en coaches van Redwoods People Services in Rozendaal bij Arnhem.">
  <PageHeader eyebrow="Team" title="Ervaren therapeuten, met plezier en passie voor het vak" intro="Onze therapeuten begeleiden je met al hun kennis en levenservaring. Allemaal zijn ze aangesloten bij beroepsverenigingen als VIT, RBCZ en SCAG." />
  <Section>
    <div class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      {team.map((m) => <TeamCard member={m} />)}
    </div>
  </Section>
  <Cta />
</Base>

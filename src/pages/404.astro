---
import Base from "../layouts/Base.astro";
import Section from "../components/Section.astro";
---

<Base title="Pagina niet gevonden" description="Deze pagina bestaat niet (meer)." noindex>
  <Section>
    <div class="mx-auto max-w-2xl text-center">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 text-4xl font-bold">Deze pagina bestaat niet (meer)</h1>
      <p class="mt-5 text-xl text-muted">Misschien is de pagina verplaatst. Kijk bij onze diensten of neem contact op.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn-primary">Naar de homepage</a>
        <a href="/contact/" class="btn-secondary">Contact</a>
      </div>
    </div>
  </Section>
</Base>

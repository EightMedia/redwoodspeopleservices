---
import Base from "../../layouts/Base.astro";
import Section from "../../components/Section.astro";
---

<Base title="Bedankt voor je bericht" description="We hebben je bericht ontvangen en nemen zo snel mogelijk contact met je op." noindex>
  <Section>
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="text-4xl font-bold">Bedankt, je bericht is verstuurd.</h1>
      <p class="mt-5 text-xl text-muted">We nemen zo snel mogelijk contact met je op, per e-mail of telefoon.</p>
      <a href="/" class="btn-primary mt-8">Terug naar de homepage</a>
    </div>
  </Section>
</Base>

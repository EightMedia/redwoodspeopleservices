---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

interface Props {
  member: CollectionEntry<"team">;
  compact?: boolean;
}
const { member, compact = false } = Astro.props;
const { name, role, intro, photo } = member.data;
---

<article class="group flex flex-col">
  <a href={`/team/${member.id}/`} class="block overflow-hidden rounded-3xl bg-sand" aria-hidden="true" tabindex="-1">
    <Image src={photo} alt="" width={640} height={720} class="aspect-[8/9] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]" />
  </a>
  <h3 class="mt-5 text-2xl font-bold"><a href={`/team/${member.id}/`} class="hover:text-brand-dark">{name}</a></h3>
  <p class="mt-1 text-brand-dark">{role}</p>
  {!compact && <p class="mt-3 text-muted">{intro}</p>}
  <a href={`/team/${member.id}/`} class="mt-3 inline-flex items-center gap-1 font-medium text-brand-dark">Lees meer over {name.split(" ")[0]} <span aria-hidden="true">→</span></a>
</article>

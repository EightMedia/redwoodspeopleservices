---
/**
 * Plaatspagina: één dienst voor één plaats of regio (bijv. Relatietherapie Arnhem).
 * Eigen tekst per pagina; de opbouw en de zijbalk zijn gedeeld.
 */
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import PageHeader from "./PageHeader.astro";
import Section from "./Section.astro";
import Faq from "./Faq.astro";
import ContactForm from "./ContactForm.astro";
import TeamCard from "./TeamCard.astro";
import { site } from "../data/site";

interface Props {
  metaTitle: string;
  metaDescription: string;
  eyebrow: string;
  title: string;
  intro: string;
  /** Tekstblokken: kop + alinea's. Alinea's mogen HTML bevatten (links). */
  blokken: { kop: string; alineas: string[] }[];
  route: { kop: string; items: string[] };
  faq: { q: string; a: string }[];
  /** id's uit src/content/team die op deze pagina worden getoond */
  teamIds: string[];
  teamKop: string;
  dienst: { label: string; href: string };
  verwant: { label: string; href: string }[];
  formulierOnderwerp: string;
  service: { name: string; description: string; plaatsen: string[] };
}
const p = Astro.props;
const team = (await getCollection("team")).filter((m) => p.teamIds.includes(m.id)).sort((a, b) => p.teamIds.indexOf(a.id) - p.teamIds.indexOf(b.id));
const ld = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: p.service.name,
  description: p.service.description,
  serviceType: p.service.name,
  provider: { "@id": `${site.url}/#organization` },
  areaServed: p.service.plaatsen.map((naam) => ({ "@type": "City", name: naam })),
  url: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Base title={p.metaTitle} description={p.metaDescription} bareTitle jsonLd={ld}>
  <PageHeader eyebrow={p.eyebrow} title={p.title} intro={p.intro} />
  <Section>
    <div class="grid gap-12 lg:grid-cols-[1fr_320px]">
      <div class="prose-site">
        {p.blokken.map((b) => (
          <>
            <h2>{b.kop}</h2>
            {b.alineas.map((a) => <p set:html={a} />)}
          </>
        ))}
        <h2>{p.route.kop}</h2>
        <ul>
          {p.route.items.map((i) => <li set:html={i} />)}
        </ul>
      </div>
      <aside class="space-y-6 lg:sticky lg:top-28 lg:self-start">
        <div class="rounded-3xl bg-brand-tint p-6">
          <p class="font-display text-xl font-bold">Een eerste stap zetten?</p>
          <p class="mt-2 text-muted">Bel of mail ons, of laat je gegevens achter. Edwin, onze praktijkcoördinator, neemt contact met je op.</p>
          <a href="/contact/" class="btn-primary mt-4 w-full">Neem contact op</a>
          <a href="/tarieven/" class="btn-ghost mt-2 w-full">Tarieven en vergoeding</a>
        </div>
        <div class="rounded-3xl border border-line p-6">
          <p class="font-display text-lg font-bold">Praktijk</p>
          <address class="mt-3 not-italic leading-relaxed text-muted">
            {site.name}<br />{site.address.street}<br />{site.address.postalCode} {site.address.city}<br />
            <a href={`tel:${site.phoneHref}`} class="text-brand-dark hover:underline">{site.phone}</a>
          </address>
        </div>
        <div class="rounded-3xl border border-line p-6">
          <p class="font-display text-lg font-bold">Lees ook</p>
          <ul class="mt-3 space-y-2">
            <li><a href={p.dienst.href} class="text-brand-dark hover:underline">{p.dienst.label}</a></li>
            {p.verwant.map((l) => <li><a href={l.href} class="text-brand-dark hover:underline">{l.label}</a></li>)}
          </ul>
        </div>
      </aside>
    </div>
  </Section>
  {team.length > 0 && (
    <Section tone="sand">
      <h2 class="text-3xl font-bold sm:text-4xl">{p.teamKop}</h2>
      <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {team.map((m) => <TeamCard member={m} compact />)}
      </div>
      <p class="mt-8"><a href="/team/" class="font-medium text-brand-dark hover:underline">Bekijk het hele team →</a></p>
    </Section>
  )}
  <Section>
    <div class="max-w-3xl"><Faq items={p.faq} /></div>
  </Section>
  <Section tone="tint">
    <div class="grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="text-3xl font-bold sm:text-4xl">Stel je vraag</h2>
        <p class="measure mt-4 text-muted">Twijfel je of dit bij je past, of wil je weten of er plek is? Laat je vraag achter en we nemen contact met je op.</p>
      </div>
      <ContactForm subject={p.formulierOnderwerp} />
    </div>
  </Section>
</Base>
